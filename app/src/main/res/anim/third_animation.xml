<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="750">
    <scale
        android:fromXScale="0"
        android:fromYScale="0"
        android:toXScale="1"
        android:toYScale="1"
        />

    <rotate
        android:fromDegrees="360"
        android:toDegrees="0"
        android:pivotX="200"
        android:pivotY="200"/>
</set>